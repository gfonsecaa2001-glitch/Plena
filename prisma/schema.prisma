// Banco de dados do Plena.
// Postgres (Neon) — a URL vem do .env local ou das variáveis de ambiente da Vercel.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// A conta do nutricionista. Todo dado do sistema pertence a um nutricionista —
// é isso que prepara o sistema para virar SaaS multi-usuário: basta filtrar
// tudo por nutritionistId.
model Nutritionist {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String? // hash bcrypt da senha — nunca guardamos a senha em si
  role         String        @default("user") // "user" | "admin" (admin vê o painel do negócio)
  lastLoginAt  DateTime? // atualizado a cada login, pra medir uso real
  createdAt    DateTime      @default(now())

  // Conexão opcional com o Google Agenda. Fica separada do login de propósito:
  // desconectar o calendário nunca pode derrubar o acesso à conta.
  googleEmail        String? // qual conta Google está conectada (para exibir)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiry  DateTime?

  // Agendamento público: o paciente escolhe o horário sozinho por um link.
  bookingSlug    String?  @unique // ex.: "gabriel-fonseca" → /agendar/gabriel-fonseca
  bookingEnabled Boolean  @default(false)
  bookingDays    String   @default("1,2,3,4,5") // 1=segunda … 7=domingo
  bookingStart   Int      @default(8) // primeira hora atendida
  bookingEnd     Int      @default(18) // última hora (exclusiva)
  bookingSlotMin Int      @default(60) // duração de cada encaixe, em minutos
  patients     Patient[]
  appointments Appointment[]
  charges      Charge[]

  // Valor padrão da consulta, em centavos — só para preencher o formulário.
  defaultPriceCents Int?

  // Identificação profissional. Vai impressa no plano que o paciente leva
  // para casa: sem o CRN, o documento não identifica quem prescreveu.
  crn      String? // ex.: "CRN-3 12345"
  phone    String? // telefone de contato do consultório
  city     String? // cidade/UF, para o rodapé do plano
  clinic   String? // nome do consultório ou da marca, se houver
}

// Cobrança: uma consulta, um pacote ou qualquer serviço a receber.
//
// O valor fica em CENTAVOS (inteiro). Guardar dinheiro como decimal quebrado
// acumula erro de arredondamento — 0,1 + 0,2 não dá exatamente 0,3 em ponto
// flutuante, e num relatório de faturamento isso vira diferença de caixa.
model Charge {
  id             String       @id @default(cuid())
  nutritionistId String
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  description String
  amountCents Int
  status      String    @default("pendente") // pendente | pago | cancelado
  dueDate     DateTime?
  paidAt      DateTime?
  method      String? // pix | dinheiro | cartao | transferencia | outro
  createdAt   DateTime  @default(now())

  @@index([nutritionistId, status])
  @@index([patientId])
}

model Patient {
  id             String        @id @default(cuid())
  nutritionistId String
  nutritionist   Nutritionist  @relation(fields: [nutritionistId], references: [id])
  name           String
  email          String?
  phone          String?
  birthDate      DateTime?
  sex            String? // "F" | "M" | "Outro"
  goal           String? // objetivo: emagrecimento, hipertrofia, saúde...
  anamnesis      String? // histórico clínico / anamnese em texto livre

  // Situação no acompanhamento. Sem isso, quem parou de vir há um ano
  // continua poluindo a lista e os alertas de "sem retorno".
  status String @default("ativo") // ativo | inativo | alta

  // Prescrição energética. O gasto (GET) é calculado a partir de peso, altura,
  // idade, sexo e nível de atividade; a META é decisão clínica do
  // nutricionista (déficit para emagrecer, superávit para ganhar massa).
  activityLevel Float? // 1.2 sedentário … 1.9 muito intenso
  kcalTarget    Int? // meta calórica diária
  proteinTarget Float? // metas de macros em gramas
  carbTarget    Float?
  fatTarget     Float?
  createdAt      DateTime      @default(now())
  measurements   Measurement[]
  appointments   Appointment[]
  mealPlans      MealPlan[]
  notes          Note[]
  charges        Charge[]
}

// Registro clínico e anotações do acompanhamento.
//
// Um só modelo para os dois casos, porque ambos aparecem na mesma linha do
// tempo e se comportam igual:
//   • kind "evolucao" + appointmentId → a evolução escrita após uma consulta
//   • kind "nota" (sem consulta)      → contato por telefone, observação avulsa
model Note {
  id            String   @id @default(cuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String? // preenchido quando é a evolução de uma consulta
  kind          String   @default("nota") // "evolucao" | "nota"
  content       String
  createdAt     DateTime @default(now())

  @@index([patientId])
  @@index([appointmentId])
}

// Uma avaliação antropométrica (medidas de uma data).
model Measurement {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  weightKg   Float?
  heightCm   Float?
  bodyFatPct Float?
  waistCm    Float?
  hipCm      Float?
  notes      String?

  // Dobras cutâneas, em MILÍMETROS. São sete porque é o conjunto que os
  // protocolos usados no Brasil pedem — Pollock de 7, Pollock de 3 (um
  // subconjunto, diferente para homens e mulheres) e Faulkner de 4.
  // Ficam nulas quando o nutricionista não usa adipômetro.
  tricepsMm     Float?
  subscapularMm Float?
  suprailiacMm  Float?
  abdominalMm   Float?
  thighMm       Float?
  chestMm       Float?
  midaxillaryMm Float?

  // Qual protocolo gerou o % de gordura calculado (pollock7 | pollock3 | faulkner).
  // Guardado junto porque comparar avaliações feitas por protocolos
  // diferentes é comparar coisas diferentes.
  skinfoldProtocol String?
}

model Appointment {
  id             String       @id @default(cuid())
  nutritionistId String
  nutritionist   Nutritionist @relation(fields: [nutritionistId], references: [id])
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  status         String       @default("agendada") // agendada | realizada | faltou | cancelada
  notes          String?
  googleEventId  String? // id do evento espelhado no Google Agenda (se conectado)
  source         String       @default("interno") // "interno" | "publico" (link de agendamento)
  createdAt      DateTime     @default(now())
}

// Contador de tentativas por janela de tempo, usado para limitar abuso nos
// pontos abertos do sistema (login, cadastro e agendamento público).
//
// Fica no banco, e não em memória, porque o app roda em várias instâncias na
// Vercel: um contador em memória seria zerado a cada instância nova e não
// serviria de nada.
model RateLimit {
  key       String   @id // ex.: "login:ip:1.2.3.4" ou "login:email:a@b.com"
  count     Int      @default(0)
  windowAt  DateTime @default(now()) // início da janela atual
  updatedAt DateTime @updatedAt

  @@index([windowAt])
}

// Tabela de composição de alimentos.
//
// Base: TACO (Tabela Brasileira de Composição de Alimentos, UNICAMP/NEPA) —
// a referência usada por nutricionistas no Brasil. Todos os valores são
// POR 100 GRAMAS do alimento.
//
// Alimentos com nutritionistId são criações do próprio nutricionista
// (receitas, produtos de marca); os da TACO têm nutritionistId nulo e são
// compartilhados por todos.
model Food {
  id             String   @id @default(cuid())
  tacoId         Int? // id original na TACO, quando veio de lá
  name           String
  category       String
  kcal           Float
  proteinG       Float
  carbG          Float
  fatG           Float
  fiberG         Float?
  sodiumMg       Float?
  nutritionistId String? // nulo = alimento público da TACO
  createdAt      DateTime @default(now())

  @@index([name])
  @@index([nutritionistId])
}

// Plano alimentar. O conteúdo (refeições e alimentos) fica em JSON por enquanto;
// quando o módulo evoluir, viram tabelas próprias (Meal, FoodItem).
model MealPlan {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("[]") // JSON: [{ meal: "Café da manhã", items: ["..."] }]
  createdAt DateTime @default(now())

  // Link para o paciente ver o plano no celular, sem login.
  //
  // O endereço secreto NÃO é senha: quem receber o link vê o plano. Por isso
  // ele tem validade e pode ser revogado — é dado de saúde circulando por
  // WhatsApp, e um link eterno acaba encaminhado para o grupo da família.
  shareToken     String?   @unique
  shareExpiresAt DateTime?
}
